# Public site origin used for canonical URLs, robots, and sitemap.
# Required for production; keep it empty for local development.
NEXT_PUBLIC_SITE_URL=

# Better Auth origin override. Required in production (or use NEXT_PUBLIC_SITE_URL).
BETTER_AUTH_URL=

# Server-only Better Auth secret. Required and must be a strong random value in production.
BETTER_AUTH_SECRET=

# Server-only MongoDB connection. The database name in the URI is the single
# authoritative target: `sayva` (host mongodb://localhost:27017/). Production
# requires an authenticated least-privilege URI with network/TLS policy set
# by deployment, pointing at the same database.
MONGODB_URI=mongodb://localhost:27017/sayva
