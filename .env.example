# ── Sayva · environment template ─────────────────────────────
# Local development: copy this file, then start the app.
#   cp .env.example .env
#   npm run dev
# Values below are READY for local dev (MongoDB on localhost).
# For production, replace every value with your real secrets/URLs
# and NEVER commit the real .env file (it is gitignored by design).

# Public site URL (used for metadata, sitemap, robots).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL better-auth uses for callbacks. Must match the URL you open.
BETTER_AUTH_URL=http://localhost:3000

# Random secret for signing auth sessions.
# This one is a DEV-ONLY value — generate a fresh one for production:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=5MrCO5itYbOWrQX9meUFvtLCLyfCEzT1+0+K2LPm9S8=

# MongoDB connection string. Local default database name: sayva.
MONGODB_URI=mongodb://localhost:27017/sayva

# Seed the curriculum database with:
#   node --env-file=.env scripts/seed/sayva-content.seed.js
